# server/.env.example - commit this template, NEVER real values.
# Copy to server/.env for local use. server/.env is ignored by Git.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/benchflow

# AI_PROVIDER: "mock" (default, no credentials) or "azure-openai"
AI_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=replace-locally-only
AZURE_OPENAI_DEPLOYMENT=your-approved-deployment
AZURE_OPENAI_API_VERSION=your-approved-api-version

# Reserved for the future Microsoft Entra ID integration (unused in mock auth mode)
ENTRA_TENANT_ID=replace-locally-only
ENTRA_CLIENT_ID=replace-locally-only
ENTRA_CLIENT_SECRET=replace-locally-only

LOG_LEVEL=info

# Development-only mock identity. The server refuses to start with AUTH_MODE=mock in production.
AUTH_MODE=mock
MOCK_DEFAULT_ROLE=employee

# Assistant limits
RATE_LIMIT_ASSISTANT_MAX=20
AI_TIMEOUT_MS=20000
