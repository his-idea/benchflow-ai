{
  "name": "benchflow-client",
  "version": "1.0.0",
  "private": true,
  "description": "BenchFlow AI Angular frontend",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "angular-eslint": "22.6.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "jsdom": "30.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
